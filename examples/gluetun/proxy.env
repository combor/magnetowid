# Set the address of the Gluetun HTTP proxy reachable from magnetowid.
# With the Privoxy workaround, set all four proxy URLs to http://127.0.0.1:8118.
HTTP_PROXY=http://127.0.0.1:8888
HTTPS_PROXY=http://127.0.0.1:8888
# FFmpeg uses lowercase http_proxy for HTTP and HTTPS.
http_proxy=http://127.0.0.1:8888
https_proxy=http://127.0.0.1:8888
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1
