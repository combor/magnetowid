# Use the same long, random API key for the indexer and download client.
VODARR_API_KEY=

# Host folder shared with Sonarr/Radarr. Create it before starting vodarr.
VODARR_DOWNLOAD_PATH=./downloads

# On Linux, use the IDs of the account that owns the download folder.
# Run id -u and id -g to check your current account's IDs.
VODARR_UID=1000
VODARR_GID=1000
