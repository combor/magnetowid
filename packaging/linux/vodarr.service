# Settings go in /etc/vodarr/vodarr.env. To change the unit itself, run
# `systemctl edit vodarr`; package updates overwrite this file.
#
# vodarr runs in the media group used by the Sonarr and Radarr packages, so
# they can move its downloads. To share through a different group, override:
#
#   [Service]
#   Group=yourgroup

[Unit]
Description=vodarr VOD downloader for Sonarr and Radarr
Documentation=https://github.com/combor/vodarr/blob/main/docs/usage.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=vodarr
Group=media
UMask=0002
Environment=VODARR_DOWNLOAD_DIR=/var/lib/vodarr/downloads
EnvironmentFile=/etc/vodarr/vodarr.env
ExecStart=/usr/bin/vodarr
StateDirectory=vodarr
Restart=on-failure
RestartSec=10
# Only vodarr gets SIGTERM: it stops ffmpeg and requeues the download itself.
# An ffmpeg stopped first would use up one of the job's retries.
KillMode=mixed

# Hardening
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
# Not strict, so the download folder can be anywhere the vodarr user can write.
ProtectSystem=full
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SocketBindAllow=tcp
SocketBindDeny=any
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
