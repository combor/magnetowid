# Restart with `systemctl restart magnetowid` after editing. Settings:
# https://github.com/combor/magnetowid/blob/main/docs/usage.md#configuration

# Required: generate with `openssl rand -hex 32`; use for both Sonarr/Radarr connections.
MAGNETOWID_API_KEY=

# Shared downloads; must be writable by magnetowid or the media group.
#MAGNETOWID_DOWNLOAD_DIR=/var/lib/magnetowid/downloads

#MAGNETOWID_LISTEN=:8484
#MAGNETOWID_CATEGORIES=tv,movies
#MAGNETOWID_LOG_LEVEL=info
