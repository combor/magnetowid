# Settings for the magnetowid service. Run `systemctl restart magnetowid` after
# changing them. All settings:
# https://github.com/combor/magnetowid/blob/main/docs/usage.md#configuration

# Required. A long, random key, e.g. from `openssl rand -hex 32`. Use the same
# key for the indexer and download client in Sonarr/Radarr.
MAGNETOWID_API_KEY=

# Folder shared with Sonarr/Radarr. The magnetowid user or media group needs
# write access to it.
#MAGNETOWID_DOWNLOAD_DIR=/var/lib/magnetowid/downloads

#MAGNETOWID_LISTEN=:8484
#MAGNETOWID_CATEGORIES=tv,movies
