# Settings: /etc/magnetowid/magnetowid.env. Use `systemctl edit magnetowid`
# for unit overrides; package updates overwrite this file.
#
# To share downloads through a group other than media, override:
#
#   [Service]
#   Group=yourgroup

[Unit]
Description=magnetowid VOD downloader for Sonarr and Radarr
Documentation=https://github.com/combor/magnetowid/blob/main/docs/usage.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=magnetowid
Group=media
UMask=0002
Environment=MAGNETOWID_DOWNLOAD_DIR=/var/lib/magnetowid/downloads
EnvironmentFile=/etc/magnetowid/magnetowid.env
ExecStart=/usr/bin/magnetowid
StateDirectory=magnetowid
Restart=on-failure
RestartSec=10
# Let magnetowid stop ffmpeg; stopping ffmpeg first would consume a job retry.
KillMode=mixed

CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
# Allow downloads outside system directories without a ReadWritePaths override.
ProtectSystem=full
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SocketBindAllow=tcp
SocketBindDeny=any
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
