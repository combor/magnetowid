# Settings go in /etc/magnetowid/magnetowid.env. To change the unit itself, run
# `systemctl edit magnetowid`; package updates overwrite this file.
#
# magnetowid runs in the media group used by the Sonarr and Radarr packages, so
# they can move its downloads. To share through a different group, override:
#
#   [Service]
#   Group=yourgroup

[Unit]
Description=magnetowid VOD downloader for Sonarr and Radarr
Documentation=https://github.com/combor/magnetowid/blob/main/docs/usage.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=magnetowid
Group=media
UMask=0002
Environment=MAGNETOWID_DOWNLOAD_DIR=/var/lib/magnetowid/downloads
EnvironmentFile=/etc/magnetowid/magnetowid.env
ExecStart=/usr/bin/magnetowid
StateDirectory=magnetowid
Restart=on-failure
RestartSec=10
# Only magnetowid gets SIGTERM: it stops ffmpeg and requeues the download
# itself. An ffmpeg stopped first would use up one of the job's retries.
KillMode=mixed

# Hardening
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
# Not strict, so the download folder can be anywhere the magnetowid user can
# write.
ProtectSystem=full
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SocketBindAllow=tcp
SocketBindDeny=any
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
