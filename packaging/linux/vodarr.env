# Settings for the vodarr service. Run `systemctl restart vodarr` after
# changing them. All settings:
# https://github.com/combor/vodarr/blob/main/docs/usage.md#configuration

# Required. A long, random key, e.g. from `openssl rand -hex 32`. Use the same
# key for the indexer and download client in Sonarr/Radarr.
VODARR_API_KEY=

# Folder shared with Sonarr/Radarr. The vodarr user or media group needs write
# access to it.
#VODARR_DOWNLOAD_DIR=/var/lib/vodarr/downloads

#VODARR_LISTEN=:8484
#VODARR_CATEGORIES=tv,movies
